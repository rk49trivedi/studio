# Environment Variables Template for SpanishLingo Studios
# Copy this file to .env and fill in your actual values

# Node Environment
NODE_ENV=production
PORT=3000

# Builder.io API Key (if using)
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__

# Ping Message (for API testing)
PING_MESSAGE="ping pong"

# SMTP Configuration (Required for newsletter subscription)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@studio.com
SMTP_PASSWORD=your_smtp_password_here

# Owner Email (Optional - defaults to SMTP_USER if not set)
OWNER_EMAIL=your-email@example.com

# Site Name (Optional - defaults to "SPANISHLINGO STUDIOS")
SITE_NAME=SPANISHLINGO STUDIOS
